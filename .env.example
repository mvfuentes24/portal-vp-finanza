# =====================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar como .env y completar con valores reales.
# Este archivo NO debe contener secretos reales.
# =====================================================

# --- Base de datos (PostgreSQL) ---
# Servidor y puerto de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
# Base de datos y usuario de la aplicacion (sin privilegios de administrador)
DB_NAME=portal_finanzas
DB_USER=portal_app
# Contraseña definida al crear el usuario portal_app
DB_PASSWORD=cambia_esto

# --- Autenticacion (JWT) ---
# Clave secreta para firmar los tokens de sesion. Debe ser larga y aleatoria.
JWT_SECRET_KEY=genera_una_clave_aleatoria_larga
# Algoritmo de firma del token
JWT_ALGORITHM=HS256
# Duracion de la sesion, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30
# true solo si el portal se sirve por HTTPS (la cookie de sesion viaja cifrada)
COOKIE_SECURE=false

# --- Frontend autorizado (CORS) ---
# URL desde la que el frontend puede consumir la API
FRONTEND_ORIGIN=http://localhost:5173

# --- Usuarios de prueba ---
# Contraseña que recibiran todos los usuarios de prueba (minimo 12 caracteres).
# Solo la usa el script backend/scripts/crear_usuarios.py
DEMO_PASSWORD=define_una_contraseña_de_al_menos_12_caracteres
