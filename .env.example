# =====================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar como .env y completar con valores reales.
# Este archivo NO debe contener secretos reales.
# =====================================================

# --- Base de datos (PostgreSQL) ---
# Servidor y puerto de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_finanzas
DB_USER=portal_app
# Contraseña definida al crear el usuario portal_app
DB_PASSWORD=cambia_esto

# --- Autenticacion (JWT) ---
# Clave secreta para firmar los tokens de sesion. Debe ser larga y aleatoria.
JWT_SECRET_KEY=genera_una_clave_aleatoria_larga
# Algoritmo de firma del token
JWT_ALGORITHM=HS256
# Duracion de la sesion, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend autorizado (CORS) ---
# URL desde la que el frontend puede consumir la API
FRONTEND_ORIGIN=http://localhost:5173